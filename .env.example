# Copie ce fichier en .env (jamais commité) et remplis ce dont tu as besoin.

# Variantes de paroles + transcription Whisper via OpenRouter
OPENROUTER_API_KEY=
# VIRALCYB_OPENROUTER_MODEL=anthropic/claude-opus-5
# VIRALCYB_OPENROUTER_STT_MODEL=openai/whisper-1
# VIRALCYB_PUBLIC_URL=https://ton-domaine.app

# Alternative : API Anthropic en direct
# ANTHROPIC_API_KEY=

# Production : restreindre les origines autorisées
# VIRALCYB_ALLOWED_ORIGINS=https://ton-domaine.app

# Moteurs GPU optionnels (voir server/README.md)
# VIRALCYB_ACESTEP_URL=http://127.0.0.1:8001
# VIRALCYB_SEEDVC_DIR=/opt/seed-vc
