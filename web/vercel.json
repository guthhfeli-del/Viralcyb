{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://server-olive-ten-84.vercel.app/api/:path*" },
    { "source": "/((?!api/|assets/|models/).*)", "destination": "/index.html" }
  ]
}
